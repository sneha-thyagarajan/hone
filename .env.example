# Copy to .env and fill in your values.
# These are only needed for the AI features – the rest of the app works without them.

# OpenAI-compatible base URL (default: OpenAI; change to http://localhost:11434/v1 for Ollama)
VITE_AI_BASE_URL=https://api.openai.com/v1

# Model to use (e.g. gpt-4o-mini, llama3, mistral)
VITE_AI_MODEL=gpt-4o-mini

# Your API key – stays in the browser, never sent anywhere except your provider
VITE_AI_KEY=
